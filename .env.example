# Copy to .env. No real secrets. Empty means unset.
# Required = hosted Railway needs it for that feature. Optional = default or local fallback.

# Database — DATABASE_URL is required on Railway. Omit it locally to use SQLite.
DATABASE_URL=
# optional; local default runs/ui, image default /data (jobs, SQLite, local objects)
DATA_DIR=

# Storage — bucket and both keys are required together for S3. Omit all three for local files.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# optional; S3-compatible endpoint (Railway bucket). AWS_S3_ENDPOINT_URL is an alias.
AWS_ENDPOINT_URL_S3=
AWS_S3_ENDPOINT_URL=
# optional; default us-east-1
AWS_DEFAULT_REGION=us-east-1
# optional; virtual or path (path is chosen for localhost/MinIO)
AWS_S3_ADDRESSING_STYLE=

# Generation — default paid swap is OpenRouter Wan 3.0 (OPENROUTER_API_KEY below).
# Higgsfield frame/Seedance is the fallback when SWAP_METHOD=higgsfield.
# Live Higgsfield needs HF_KEY, or both id and secret.
HF_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# optional; 1/true/yes/on skips paid calls and uses the local frame mock. Image default is 0.
MOCK_HIGGSFIELD=1
# optional; wan (default) or higgsfield
SWAP_METHOD=wan
# optional; CLI model wan27
REPLICATE_API_TOKEN=
# optional; CLI model wan-vace
FAL_KEY=
# optional; CLI model wan-vace-modal (set both)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# optional; live brand research. Unset keeps the mock /research flow.
TINYFISH_API_KEY=

# Moment finding (Gemini) and the default Wan 3.0 placement swap. Local YuNet/YOLOX suggest ignores it.
# Required on Railway for paid swaps unless SWAP_METHOD=higgsfield (then use HF_KEY).
OPENROUTER_API_KEY=
# optional; OpenRouter model id for the Gemini finder
MOMENT_MODEL=google/gemini-3.8-flash

# App flags
# optional; hosted (default), test, or all
VIDEO_SOURCE=hosted
# optional; Railway injects this. Image default 3000.
PORT=3000
# optional; container bind address
HOSTNAME=0.0.0.0
# optional; image default /app. Local Next uses the parent of web/.
REPO_ROOT=
# optional; ONNX cache. Image default /app/models.
MODEL_CACHE_DIR=
# optional; image default python3. Local non-production falls back to .venv.
PYTHON_BIN=
# optional
PYTHONPATH=
# optional; Next sets production in the image. Leave unset locally (do not set to empty).
# NODE_ENV=
# optional
NEXT_TELEMETRY_DISABLED=1
# optional; entrypoint seeds Blender titles on boot when 1 or true
SEED_CATALOG_ON_BOOT=1
# optional; movie-import scratch. Default $DATA_DIR/tmp.
IMPORT_TMP_DIR=
# optional; seconds
FFMPEG_TIMEOUT_S=7200
# optional; also caps OMP_NUM_THREADS for ffmpeg when that var is unset
FFMPEG_THREADS=4
IMPORT_MAX_ATTEMPTS=3
# optional; import-movies worker poll interval, seconds
IMPORT_POLL_S=60
# optional; set to 1 to run the Postgres/MinIO integration test
RUN_PG_MINIO=
